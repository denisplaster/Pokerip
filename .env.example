# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by the app, Prisma CLI and seed script.
DATABASE_URL="postgresql://pokerip:pokerip@localhost:5432/pokerip"
# Separate database used by `npm run test:integration` (it is wiped on every run).
DATABASE_URL_TEST="postgresql://pokerip:pokerip@localhost:5432/pokerip_test"

# ── Auth.js ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Set to true when self-hosting behind a proxy (Vercel sets this automatically).
AUTH_TRUST_HOST=true
# Optional OAuth providers. Leave empty to disable.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# ── Seed ──────────────────────────────────────────────────────────────────────
# Admin account created by `npm run db:seed`. If the password is empty a random
# one is generated and printed once to the console.
SEED_ADMIN_EMAIL="admin@ripvault.local"
SEED_ADMIN_USERNAME="vaultkeeper"
SEED_ADMIN_PASSWORD=""

# ── Scheduled jobs ────────────────────────────────────────────────────────────
# Bearer token required by /api/cron/market-tick (Vercel Cron sends it automatically
# when CRON_SECRET is set in the project).
CRON_SECRET=""
